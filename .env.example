# PostgreSQL connection used for private app data and server sessions.
DATABASE_URL=postgresql://postgres:password@localhost:5432/one_ball_at_a_time

# Single-owner lock for the private app. This is not multi-user authentication.
ACCESS_PIN=choose-a-private-pin-max-40-chars

# Generate a strong value with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

PORT=8791
NODE_ENV=development

# Set to 1 only when deployed behind a trusted reverse proxy.
TRUST_PROXY=0
